@model BookFilterViewModel
@{
    ViewData["Title"] = "Index";
}
<h1>Books</h1>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="searchTerm" value="@Model.SearchTerm"
               class="form-control" placeholder="Search a title or autor…" />
    </div>
    <div class="col-md-2">
        <select name="category" class="form-select">
            <option value="">All category</option>
            @foreach (SelectListItem item in Model.Categories
                        ?? new SelectList(Enumerable.Empty<string>()))
            {
                <option value="@item.Value" selected="@(item.Value == Model.Category)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="availability" class="form-select">
            <option value="">All</option>
            <option value="available" selected="@(Model.Availability == "available")">available</option>
            <option value="onloan" selected="@(Model.Availability == "onloan")">onloan</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">Rechercher</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Erease</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">+ Add a book</a>
</p>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Autor</th>
            <th>Category</th>
            <th>ISBN</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Books)   // ← on itère sur Model.Books, pas Model
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Author</td>
            <td>@item.Category</td>
            <td>@item.Isbn</td>
            <td>
                <span class="badge @(item.IsAvailable ? "bg-success" : "bg-danger")">
                    @(item.IsAvailable ? "Availaible" : "On loan")
                </span>
            </td>
            <td>
                <a asp-action="Edit"    asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>