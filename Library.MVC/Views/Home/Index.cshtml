@{
    ViewData["Title"] = "Home";
}

<div class="py-4">
    <h1>Library</h1>
    <p class="text-muted">management system for books.</p>
    <hr />
</div>

<div class="row g-3">
    <div class="col-md-4">
         <div class="card-body">
            <h5 class="card-title">Books</h5>
            <p class="card-text text-muted">Browse and manage the book</p>
            <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary">View Books</a>
         </div>
    </div>
    <div class="col-md-4">
        <div class="card-body">
            <h5 class="card-title">Members</h5>
            <p class="card-text text-muted">View and manage library members.</p>
            <a asp-controller="Members" asp-action="Index" class="btn btn-outline-primary">View Members</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-body">
            <h5 class="card-title">Loans</h5>
            <p class="card-text text-muted">Track and return books</p>
            <a asp-controller="Loans" asp-action="Index" class="btn btn-outline-primary">View Loans</a>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <div class="card-body">
                <h5 class="card-title">Role Management</h5>
                <p class="card-text text-muted">Manage user roles and access.</p>
                <a asp-controller="Admin" asp-action="Roles" class="btn btn-outline-secondary">Manage Roles</a>
            </div>
        </div>
    </div>
}