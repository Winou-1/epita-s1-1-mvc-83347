@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Role Management";
}
<h2>Role Management</h2>

<div class="col-md-4 mb-4">
    <h4>Create Role</h4>
    <form asp-action="CreateRole" method="post" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <input name="roleName" class="form-control" placeholder="Role name…" required />
        <button class="btn btn-success">Add</button>
    </form>
</div>

<h4>Existing Roles</h4>
<table class="table table-hover col-md-4">
    <thead class="table-dark"><tr><th>Name</th><th></th></tr></thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>
                    <form asp-action="DeleteRole" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="roleId" value="@role.Id" />
                        <button class="btn btn-sm btn-danger"
                                onclick="return confirm('Delete @role.Name?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>