@model IEnumerable<Library.Domain.Loan>
@{
    ViewData["Title"] = "Prêts";
}
<h1>Prêts</h1>
<p>
    <a asp-action="Create" class="btn btn-success">+ Nouveau prêt</a>
</p>
<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Livre</th>
            <th>Membre</th>
            <th>Date de prêt</th>
            <th>Date de retour prévue</th>
            <th>Statut</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var overdue = item.ReturnedDate is null && item.DueDate < DateTime.Today;
            <tr class="@(overdue ? "table-danger" : "")">
                <td>@item.Book.Title</td>
                <td>@item.Member.FullName</td>
                <td>@item.LoanDate.ToShortDateString()</td>
                <td>@item.DueDate.ToShortDateString()</td>
                <td>
                    @if (item.ReturnedDate.HasValue)
                    {
                        <span class="badge bg-success">Retourné le @item.ReturnedDate.Value.ToShortDateString()</span>
                    }
                    else if (overdue)
                    {
                        <span class="badge bg-danger">EN RETARD</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Actif</span>
                    }
                </td>
                <td>
                    @if (item.ReturnedDate is null)
                    {
                        <form asp-action="MarkReturned" asp-route-id="@item.Id" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-success">Marquer retourné</button>
                        </form>
                    }
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Détails</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>